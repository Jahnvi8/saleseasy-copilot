# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your_key_here
# One model, or a comma-separated fallback chain tried in order on overload/quota errors.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.8-flash,gemini-3.1-flash-lite

# Set to "mock" to run without any API key (deterministic keyword-based adapter).
# Set to "gemini" (default) to use the real model.
LLM_PROVIDER=gemini

# Basic abuse limits
MAX_INPUT_CHARS=2000
RATE_LIMIT_PER_MINUTE=20

# Comma-separated list of allowed browser origins for CORS
ALLOWED_ORIGINS=http://localhost:5173
